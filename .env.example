# Unity Hearts — environment variables
#
# Copy this file to `.env` for local development and fill in the values.
# NEVER commit `.env`. This repository is public.
# Names only here; get real values from Lovable → Cloud, or your own records.

# ─────────────────────────────────────────────────────────────
# 1. Web app (Vite) — read at build time, safe to ship to browsers
# ─────────────────────────────────────────────────────────────
# If these are missing, vite.config.ts falls back to the production
# project (nyhlwamvqjmaxpmqxzah). Set them to point somewhere else.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# Cloudflare Turnstile captcha on sign-in / sign-up (public site key)
VITE_TURNSTILE_SITE_KEY=
# Native app push notifications. Leave empty until the Firebase file
# (android/app/google-services.json) and the APNs key are set up — with it
# "on" and no Firebase file, the Android app crashes when asking for a token.
# See docs/PUSH_NOTIFICATIONS.md.
VITE_PUSH_NOTIFICATIONS=

# ─────────────────────────────────────────────────────────────
# 2. Supabase Edge Function secrets — set in Lovable → Cloud → Secrets,
#    NOT in .env. Listed here so nothing is forgotten.
# ─────────────────────────────────────────────────────────────
# Provided automatically by Supabase (no action needed):
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
#
# Must be set by you:
#   RESEND_API_KEY            Sends all emails (welcome, notifications, suspension)
#   INTERNAL_WEBHOOK_SECRET   Shared secret between database triggers and email
#                             functions; also signs unsubscribe links
#   DAILY_API_KEY             Video/voice calls (daily-room function)
#   LOVABLE_API_KEY           AI photo verification (verify-pose function)
#
# Database settings that must match (set via SQL, not env):
#   app.settings.supabase_url, app.settings.internal_webhook_secret
#
# Supabase Auth settings (dashboard, not env):
#   Turnstile secret key for captcha

# ─────────────────────────────────────────────────────────────
# 3. Tests only — local `.env` or GitHub Actions secrets
# ─────────────────────────────────────────────────────────────
# E2E suite (npm test). Point at the E2E project hawxapwjhjoaqbcslmtb,
# never at production: the suite creates and deletes users.
SUPABASE_SERVICE_ROLE_KEY=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_OBSERVER_EMAIL=
E2E_OBSERVER_PASSWORD=
# Members in the group-journey test (even, at least 10)
E2E_GROUP_SIZE=

# Production smoke test (npm run test:prod) — read-only checks on the live site
PROD_URL=
PROD_SMOKE_EMAIL=
PROD_SMOKE_PASSWORD=
